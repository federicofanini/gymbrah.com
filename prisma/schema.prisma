generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String     @id @default(cuid())
  full_name  String?
  email      String     @unique
  businesses Business[]
}

model Business {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  type        BusinessType
  description String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])

  profile   BusinessProfile?
  location  BusinessLocation?
  contact   BusinessContact?
  meta      BusinessMeta?
  embedding BusinessEmbedding?
  services  ServiceTag[]
  amenities AmenityTag[]
  gallery   Media[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id             String     @id @default(cuid())
  businessId     String     @unique
  logoUrl        String?
  coverImageUrl  String?
  pricingDetails String?
  pricingFileUrl String?
  priceRange     PriceRange

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessLocation {
  id         String  @id @default(cuid())
  businessId String  @unique
  address    String
  city       String
  region     String?
  country    String
  zipCode    String
  latitude   Float
  longitude  Float

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessContact {
  id           String  @id @default(cuid())
  businessId   String  @unique
  email        String
  phone        String?
  whatsappLink String?
  websiteUrl   String?
  bookingUrl   String?

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessMeta {
  id         String         @id @default(cuid())
  businessId String         @unique
  isVerified Boolean        @default(false)
  isFeatured Boolean        @default(false)
  status     BusinessStatus @default(PENDING)
  viewCount  Int            @default(0)

  business Business @relation(fields: [businessId], references: [id])
}

model ServiceTag {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
}

model AmenityTag {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
}

model Media {
  id         String   @id @default(cuid())
  url        String
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
}

model BusinessEmbedding {
  businessId String   @id
  embedding  Float[] // manually set up as `vector` in SQL
  business   Business @relation(fields: [businessId], references: [id])
}

enum BusinessType {
  GYM
  PERSONAL_TRAINER
  STUDIO
}

enum PriceRange {
  LOW
  MEDIUM
  HIGH
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

model exercises {
  id                String   @id @unique
  name              String?
  body_part         String?
  equipment         String?
  gif_url           String?
  target            String?
  secondary_muscles String[]
  instructions      String[]
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([body_part])
  @@index([target])
  @@index([equipment])
}
